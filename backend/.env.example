FINNHUB_API_KEY=your_finnhub_key
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AVGO,BRK-B,JPM,V,LLY,WMT,XOM,UNH,MA,JNJ,COST,ORCL,AMD,NFLX,PLTR,SMCI,TQQQ,CRM
SCAN_INTERVAL=60
AUTO_SEND_NOTIFICATIONS=true
MIN_CONFIDENCE=55
FRED_API_KEY=your_fred_key
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret

# Separate Alpaca paper account for the signal-engine / COT shadow book.
# Lowercase names (alpaca_se_api_key / alpaca_se_api_secret) are also accepted.
ALPACA_SE_API_KEY=your_se_alpaca_key
ALPACA_SE_API_SECRET=your_se_alpaca_secret

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (Homebrew Postgres — see HOWTO.md §33 for setup):
DATABASE_URL=postgresql://signal:signal_dev_pw@127.0.0.1:5432/signal_trade
# Production: replace with your managed PostgreSQL URL (Railway/Fly.io/Neon/Supabase).
# Docker Compose overrides this automatically with the internal service hostname.
# Leave blank to fall back to SQLite (not recommended for production).

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=                 # python3 -c "import secrets; print(secrets.token_hex(32))"
OWNER_EMAIL=                # Auto-creates owner account with Pro tier on startup
OWNER_PASSWORD=             # CHANGE THIS before deploying
APP_URL=http://localhost:8000  # Set to public HTTPS URL in production
                               # Controls cookie Secure flag + CORS origin lock

# ── Private preview mode ──────────────────────────────────────────────────────
# Set to a long random string to lock the entire site to only visitors who pass
# ?preview_token=<token> or have the preview_token cookie. Health checks are
# always public. Leave blank to disable.
# SITE_PRIVATE_TOKEN=         # python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Redis (optional — enables cross-process worker bus + shared cache) ─────────
# Local dev: docker run -d --name signal-trade-redis -p 127.0.0.1:6379:6379 redis:7-alpine
# REDIS_URL=redis://localhost:6379/0
# Production: use your managed Redis URL (Railway/Upstash/Redis Cloud).

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=          # sk_live_... or sk_test_... — run stripe_setup.py to fill below
STRIPE_WEBHOOK_SECRET=      # whsec_... — from Stripe dashboard webhook settings
STRIPE_PRICE_BASIC=         # Auto-filled by: python3 stripe_setup.py
STRIPE_PRICE_PRO=           # Auto-filled by: python3 stripe_setup.py

# ── Market data (optional — improves OHLCV reliability over yfinance) ─────────
POLYGON_API_KEY=          # polygon.io API key — get free at polygon.io

# ── Advanced data feeds (optional) ────────────────────────────────────────────
MASSIVE_API_KEY=          # massive.com API key for dark pool + advanced signals

# ── Risk metrics ───────────────────────────────────────────────────────────────
# Annual risk-free rate used for standard Sharpe-ratio excess-return calculation.
# Default 4.5% approximates current 3-month T-bill yields.
# RISK_FREE_RATE=0.045

# ── Residual cash overlay (optional) ───────────────────────────────────────────
# Auto-invest idle cash into SGOV; rotate to VOO when VIX is low and no drawdown.
# CASH_OVERLAY_ENABLE=false
# CASH_OVERLAY_TICKER=SGOV
# CASH_OVERLAY_BETA_TICKER=VOO
# CASH_OVERLAY_MAX_FRACTION=0.50
# CASH_OVERLAY_VIX_THRESHOLD=18.0
# CASH_OVERLAY_MIN_TRADE_DOLLARS=100.0

# ── Signal delivery tuning ────────────────────────────────────────────────────
# Cohort shadow/withheld percentages. Default 0/0 delivers every signal.
# Set to e.g. 20/10 to re-enable the experimental shadow/control framework.
# SIGNAL_COHORT_SHADOW_PCT=0
# SIGNAL_COHORT_WITHHELD_PCT=0
# LONG_ONLY=true          # false allows SELL signals through a mirrored MR gate
# MAX_SENDS_PER_TICKER_PER_DAY=1
# MAX_BUYS_PER_SECTOR_PER_DAY=2

# ── Email / SendGrid (optional — users auto-verified if not set) ──────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your_key
# SMTP_FROM=noreply@yourdomain.com

# ── Google OAuth (optional — enables "Sign in with Google") ───────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Web Push Notifications (optional) ────────────────────────────────────────
# Generate VAPID keys: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); import base64; print('PRIVATE:', base64.urlsafe_b64encode(v.private_key.private_bytes_raw()).decode()); print('PUBLIC:', base64.urlsafe_b64encode(v.public_key.public_bytes_raw()).decode())"
VAPID_PRIVATE_KEY=        # base64 VAPID private key
VAPID_SUBJECT=mailto:admin@signal.trade

# ── AI pre-execution trade evaluator (enabled by default) ─────────────────────
# Calls an LLM before every broker order. The gate runs AFTER drawdown, runtime
# risk limits, and capacity checks. If no provider key is configured, the gate
# logs a warning and lets trades proceed (AI_EVAL_FAIL_OPEN_ON_ERROR=true).
# AI_EVAL_PROVIDER=openai        # openai | anthropic | kimi | openai-compatible
# AI_EVAL_MODEL=gpt-4o-mini      # or claude-3-5-haiku-20241022, kimi model name, etc.
# AI_EVAL_TIMEOUT=15
# AI_EVAL_FAIL_OPEN_ON_ERROR=true
# AI_EVAL_BASE_URL=              # only for local/OpenAI-compatible endpoints
# OPENAI_API_KEY=                # required when AI_EVAL_PROVIDER=openai
# ANTHROPIC_API_KEY=             # required when AI_EVAL_PROVIDER=anthropic
# KIMI_API_KEY=                  # required when AI_EVAL_PROVIDER=kimi (OpenAI-compatible endpoint)
