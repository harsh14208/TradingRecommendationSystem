# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.venv/

# Environment / secrets
.env
*.env
!.env.example

# SQLite databases (test suite and any accidental local copies)
*.sqlite
*.sqlite-wal
*.sqlite-shm
**/data/trading.db
trading.db
trading.db-wal
trading.db-shm

# Generated outputs (recreated by weekly factor mining job)
backend/data/factor_weights.json
backend/data/alt_data_*.json
backend/data/cross_sectional_*.json
backend/data/*_log.txt
backend/data/cache_gdelt/

# Logs
backend/logs/
backend/logs/*.log
*.log

# Temporary screenshots / test artifacts
kill-switch-*.png

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
*.swp
*.swo

# Node (if any frontend tooling is added later)
node_modules/

# SQLite databases (all locations)
*.db
*.db-wal
*.db-shm

# Claude Code local config/memory
.claude/

# API response caches (regenerated at runtime)
backend/data/.spy_bars_cache.json
backend/data/cache_earnings/
backend/data/cache_indicators/
backend/data/cache_ohlcv/
backend/data/cache_finra_ats/
backend/data/cache_finra_short_volume/
backend/data/cache_sec_ftd/
backend/data/cache_sentiment/
backend/data/cache_wikipedia/
backend/data/cache_ff/
backend/data/*.csv

# EDGAR XBRL fundamental cache (~8 MB binary, regenerated by backtest_edgar.py --cached)
backend/data/edgar_fundamentals.pkl
.aider*

# Coverage data binary (regenerated by pytest --cov; .coveragerc/coverage.json are tracked)
backend/.coverage

# PostgreSQL dumps (large binary snapshots — never commit; exceeds GitHub 100MB limit)
*.dump

# Local runtime data folder
/data/

# Mutation testing artifacts (generated by mutmut; can be very large)
mutants/

# Local tool/agent artifacts (auto-generated; never commit)
.cgcignore
.mcp/
.playwright-mcp/
.serena/
.venv311/
