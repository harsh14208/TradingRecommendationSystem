# Signal.Trade — Environment Variables
# Copy this file to backend/.env and fill in your values.
# Required fields are marked with *.

# ── Market data ───────────────────────────────────────────────────────────────
FINNHUB_API_KEY=your_key_here           # * free at finnhub.io
WATCHLIST=NVDA,AAPL,MSFT,TSLA,META,AMZN,GOOGL,AMD,JPM,V
SCAN_INTERVAL=60                        # seconds between scans
FRED_API_KEY=your_key_here              # free at fred.stlouisfed.org — enables CPI/NFP/FOMC

# ── Notifications ─────────────────────────────────────────────────────────────
AUTO_SEND_NOTIFICATIONS=true
MIN_CONFIDENCE=55.0
TELEGRAM_BOT_TOKEN=your_bot_token       # * from @BotFather on Telegram
TELEGRAM_CHAT_ID=your_chat_id           # your personal Telegram user ID (fallback)
TELEGRAM_BROADCAST_CHANNEL_ID=-100...   # private channel for >50 subscriber broadcast
# Set to true to allow the weekly digest to send from a local dev server.
# Default false prevents accidental Telegram/email spam while coding.
WEEKLY_DIGEST_ALLOW_DEV=false

# ── Paper trading ─────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_key          # free at alpaca.markets — paper trading
ALPACA_API_SECRET=your_alpaca_secret

# ── Auth ──────────────────────────────────────────────────────────────────────
# * Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_64_char_hex_secret
OWNER_EMAIL=you@example.com             # auto-creates owner account with full access on startup
# ⚠️  OWNER_PASSWORD creates a superuser on startup. Must be 16+ characters,
# unique, and rotated after first login. Do not reuse application credentials.
OWNER_PASSWORD=your_secure_password     # change after first login

# ── Deployment ────────────────────────────────────────────────────────────────
APP_URL=https://yourdomain.com          # public HTTPS URL (required for Stripe + Telegram webhook)

# ── Stripe (run python3 stripe_setup.py after filling STRIPE_SECRET_KEY) ──────
# ⚠️  SECURITY: Never commit live Stripe keys to git. Treat sk_live_ keys like
# production passwords — they grant full access to payments and customer data.
# Use test keys (sk_test_...) for local development and live keys only in
# encrypted secrets managers / CI vaults.
STRIPE_SECRET_KEY=sk_test_or_live_key  # * from dashboard.stripe.com → API keys
STRIPE_WEBHOOK_SECRET=whsec_...         # * from Stripe → Webhooks → Signing secret
STRIPE_PRICE_BASIC=price_...           # auto-filled by stripe_setup.py
STRIPE_PRICE_PRO=price_...             # auto-filled by stripe_setup.py
STRIPE_PRICE_ELITE=price_...           # auto-filled by stripe_setup.py

# ── Web Push (optional — VAPID keys for browser notifications) ──────────────────
# 1. Generate keys: python3 -c "from py_vapid import VAPID; v=VAPID(); v.generate_keys(); print(v.save_private_key()); print(v.save_public_key())"
# 2. Or use: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ── Risk management ────────────────────────────────────────────────────────────
# DD_THROTTLE_TRIGGER_PCT=3.0            # drawdown % below peak that scales new positions
# DD_THROTTLE_MULT=0.5                   # size multiplier for new positions during drawdown

# ── Redis (optional — caching + distributed locks; required for >1 concurrent user) ──
# REDIS_URL=redis://localhost:6379

# ── Preview site token (optional — password-protects the public landing page) ──
# SITE_PRIVATE_TOKEN=your_preview_token

# ── Postgres test URL (optional — enables real Postgres e2e tests in CI) ──
# TEST_POSTGRES_URL=postgresql://user:pass@localhost:5432/test_db

# ── Unusual Whales (optional — options flow confirmation gate) ──
# UNUSUAL_WHALES_API_KEY=your_uw_key

# ── Massive.com (optional — dark pool, options, financials) ──
# MASSIVE_API_KEY=your_massive_key
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorised redirect URI: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret

# ── Observability (optional — Sentry free tier is enough for a solo project) ──
# 1. Sign up at sentry.io → Projects → Add project → Python → FastAPI
# 2. Copy the DSN (looks like https://xxx@yyy.ingest.sentry.io/zzz)
SENTRY_DSN=your_sentry_dsn_here

# ── Email / SendGrid (optional — Telegram works without this) ─────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_sendgrid_api_key

# ── Frontend analytics sink (optional) ─────────────────────────────────────────
ANALYTICS_ENABLED=true
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Signal.Trade
